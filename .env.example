PORT=3000

STEAM_API_KEY=your_steam_api_key

DATABASE_URL=postgresql://user:password@hostname/database?sslmode=require

ADMIN_PASSWORD_HASH='theadminhashfrompassword'
ADMIN_SESSION_HOURS=12

ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAME_SITE=lax

FRIEND_CRAWL_DELAY_MS=500
FRIEND_CRAWL_DEFAULT_DEPTH=2
FRIEND_CRAWL_MAX_PROFILES=2000
FRIEND_CRAWL_BATCH_SIZE=10

PROFILE_QUEUE_BATCH_SIZE=20
PROFILE_QUEUE_CONCURRENCY=2
PROFILE_QUEUE_DELAY_MS=750
PROFILE_QUEUE_MAX_ATTEMPTS=3
PROFILE_QUEUE_RETRY_DELAY_SECONDS=60
PROFILE_QUEUE_STALE_MINUTES=15

COLLECT_CRON=*/15 * * * *
RUN_ON_STARTUP=true